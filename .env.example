# ========== Supabase (required in production) ==========
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ========== Telegram ==========
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========== Cron security ==========
CRON_SECRET=generate_a_long_random_string

# ========== Optional ==========
BINANCE_API_BASE_URL=https://fapi.binance.com
NODE_ENV=production

# Login (add later when you build signup/signin)
# SITE_PASSWORD=
# SESSION_SECRET=
